#include "stdcycles.h"

// TODO (OpenPBR): implement the OpenPBR OSL shader

shader node_open_pbr_bsdf(float BaseWeight = 1.0,
                          color BaseColor = 0.8,
                          float DiffuseRoughness = 0.0,
                          float BaseMetalness = 0.0,
                          float SpecularWeight = 1.0,
                          color SpecularColor = 1.0,
                          float SpecularRoughness = 0.3,
                          float SpecularRoughnessAnisotropy = 0.0,
                          float SpecularIOR = 1.5,
                          float TransmissionWeight = 0.0,
                          color TransmissionColor = 1.0,
                          float TransmissionDepth = 0.0,
                          color TransmissionScatter = 0.0,
                          float TransmissionAnisotropy = 0.0,
                          float TransmissionDispersionScale = 0.0,
                          float TransmissionDispersionAbbeNumber = 20.0, 
                          float SubsurfaceWeight = 0.0,
                          color SubsurfaceColor = 0.8,
                          float SubsurfaceRadius = 1.0,
                          color SubsurfaceRadiusScale = {1.0, 0.5, 0.25}, 
                          float SubsurfaceScatterAnisotropy = 0.0,
                          float CoatWeight = 0.0,
                          color CoatColor = 1.0,
                          float CoatRoughness = 0.0,
                          float CoatRoughnessAnisotropy = 0.0,
                          float CoatIOR = 1.6,
                          float CoatDarkening = 1.0,
                          float FuzzWeight = 0.0,
                          color FuzzColor = 1.0,
                          float FuzzRoughness = 0.5,
                          float EmissionLuminance = 0.0,
                          color EmissionColor = 1.0,
                          float ThinFilmWeight = 0,
                          float ThinFilmThickness = 0.5,
                          float ThinFilmIOR = 1.4,
                          float GeometryOpacity = 1.0,
                          // bool GeometryThinWalled = false,   // TODO (Sebastian): No idea yet how booleans work
                          normal GeometryNormal = N,
                          normal GeometryTangent = normalize(dPdu),
                          normal GeometryCoatNormal = N,
                          normal GeometryCoatTangent = normalize(dPdu),
                          output closure color BSDF = 0)
{
  if (DiffuseRoughness < 1e-5)
    BSDF = BaseColor * diffuse(GeometryNormal);
  else
    BSDF = oren_nayar_diffuse_bsdf(GeometryNormal, clamp(BaseColor, 0.0, 1.0), DiffuseRoughness);
}
