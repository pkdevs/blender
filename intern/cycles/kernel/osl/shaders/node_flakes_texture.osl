#include "node_hash.h"
#include "stdcycles.h"
#include "vector2.h"
#include "vector4.h"

#define vector3 point

float mx_flake_density_to_probability(float x)
{
  float a = -26.19771808;
  float b = 26.39663835;
  float c = 85.53857017;
  float d = -102.35069432;
  float e = -101.42634862;
  float f = 118.45082288;
  float xx = x * x;
  return (a * xx + b * x) / (c * xx * x + d * xx + e * x + f);
}

vector mx_rotate_flake(vector p, vector rot_noise)
{
  float theta = M_PI * 2.0 * rot_noise.x;
  float phi = M_PI * 2.0 * rot_noise.y;
  float z = rot_noise.z * 2.0;

  float r = sqrt(z);
  float vx = sin(phi) * r;
  float vy = cos(phi) * r;
  float vz = sqrt(2.0 - z);

  float s_theta = sin(theta);
  float c_theta = cos(theta);
  float sx = vx * c_theta - vy * s_theta;
  float sy = vx * s_theta + vy * c_theta;

  vector result;
  result.x = (vx * sx - c_theta) * p.x + (vy * sx + s_theta) * p.y + (vz * sx) * p.z;
  result.y = (vx * sy - s_theta) * p.x + (vy * sy - c_theta) * p.y + (vz * sy) * p.z;
  result.z = (vx * vz) * p.x + (vy * vz) * p.y + (1.0 - z) * p.z;

  return result;
}

shader node_flakes_texture(string dimensions = "3D",
                           point Vector = point(0.0, 0.0, 0.0),
                           float W = 0.0,
                           float Scale = 5.0,
                           float Roughness = 0.2,
                           float Coverage = 0.5,
                           output color Color = 0.0,
                           output vector Normal = vector(0.0, 0.0, 1.0),
                           output float Fac = 0.0,
                           output float Presence = 0.0)
{
  point p = point(0.0);
  
  if (dimensions == "1D") {
    p = point(W * Scale, 0.0, 0.0);
  }
  else if (dimensions == "2D") {
    p = point(Vector[0], Vector[1], 0.0) * Scale;
  }
  else if (dimensions == "3D") {
    p = Vector * Scale;
  }
  else if (dimensions == "4D") {
    p = point(Vector[0], Vector[1], Vector[2] + W) * Scale;
  }
  else {
    warning("%s", "Unknown dimension!");
  }

  float probability = mx_flake_density_to_probability(Coverage);
  float flake_diameter = 1.5 / sqrt(3.0);
  float flake_radius2 = (flake_diameter * flake_diameter) * 3.0;

  point cell_center = point(floor(p[0]), floor(p[1]), floor(p[2])) + point(0.5);

  point closest_flake_pos = point(0.0);
  vector closest_flake_normal = vector(0.0, 0.0, 1.0);
  float closest_flake_dist2 = 1e5;
  float closest_flake_priority = -1.0;
  int flake_found = 0;

  for (int x = -1; x <= 1; x++) {
    for (int y = -1; y <= 1; y++) {
      for (int z = -1; z <= 1; z++) {
        point current_cell = cell_center + point(x, y, z);
        
        float cell_presence = hash_vector3_to_float(current_cell);
        if (cell_presence > probability) {
          continue;
        }

        float priority = hash_vector3_to_float(current_cell + point(3.0));
        point flake_pos = current_cell + hash_vector3_to_vector3(current_cell + point(1.0)) - point(0.5);
        
        vector delta = p - flake_pos;
        float dist2 = delta[0]*delta[0] + delta[1]*delta[1] + delta[2]*delta[2];

        if (dist2 < flake_radius2) {
          if (priority > closest_flake_priority) {
            closest_flake_priority = priority;
            closest_flake_dist2 = dist2;
            closest_flake_pos = current_cell;
            
            vector rot_noise = hash_vector3_to_vector3(current_cell);
            closest_flake_normal = mx_rotate_flake(vector(0.0, 0.0, 1.0), rot_noise);
            flake_found = 1;
          }
        }
      }
    }
  }

  if (flake_found) {
    vector rot_noise = hash_vector3_to_vector3(closest_flake_pos + point(2.0));
    
    float alpha2 = Roughness * Roughness;
    float theta_noise = rot_noise.x;
    float phi_noise = rot_noise.y;
    float tan_theta = sqrt(theta_noise * alpha2 / (1.0 - theta_noise));
    float sin_theta = tan_theta / sqrt(1.0 + tan_theta * tan_theta);
    float cos_theta = 1.0 / sqrt(1.0 + tan_theta * tan_theta);
    float phi = 2.0 * M_PI * phi_noise;
    
    vector local_dir = vector(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);
    
    vector t = vector(1.0, 0.0, 0.0);
    vector b = vector(0.0, 1.0, 0.0);
    
    vector perturbed_normal = local_dir.x * t + local_dir.y * b + local_dir.z * closest_flake_normal;
    Normal = normalize(perturbed_normal);
    
    Fac = hash_vector3_to_float(closest_flake_pos + point(4.0));
    Color = hash_vector3_to_color(closest_flake_pos + point(5.0));
    Presence = 1.0;
  }
  else {
    Normal = vector(0.0, 0.0, 1.0);
    Fac = 0.0;
    Color = color(0.0);
    Presence = 0.0;
  }
}
