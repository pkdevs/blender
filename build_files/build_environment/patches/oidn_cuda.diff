diff --git a/devices/cuda/CMakeLists.txt b/devices/cuda/CMakeLists.txt
--- a/devices/cuda/CMakeLists.txt
+++ b/devices/cuda/CMakeLists.txt
@@ -100,7 +100,16 @@ target_include_directories(OpenImageDenoise_device_cuda
 
 if(OIDN_DEVICE_CUDA_API STREQUAL "Driver")
   add_library(curtn STATIC curtn.cpp)
-  target_link_libraries(curtn PUBLIC CUDA::cuda_driver)
+  if(WIN32 AND CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM64" AND (CMAKE_VERSION VERSION_LESS "4.4" OR NOT EXISTS ${CUDAToolkit_LIBRARY_DIR}))
+    find_program(LIB_EXE NAMES lib llvm-lib REQUIRED)
+    add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/cuda.lib" COMMAND "${LIB_EXE}" /nologo /def:"${CMAKE_CURRENT_SOURCE_DIR}/cuda_driver.def" /out:"${CMAKE_CURRENT_BINARY_DIR}/cuda.lib" DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/cuda_driver.def")
+    add_library(cuda_driver INTERFACE "${CMAKE_CURRENT_BINARY_DIR}/cuda.lib")
+    target_link_libraries(cuda_driver INTERFACE "${CMAKE_CURRENT_BINARY_DIR}/cuda.lib")
+    target_include_directories(cuda_driver INTERFACE "${CUDAToolkit_INCLUDE_DIRS}")
+    target_link_libraries(curtn PUBLIC cuda_driver)
+  else()
+    target_link_libraries(curtn PUBLIC CUDA::cuda_driver)
+  endif()
 
   target_compile_definitions(OpenImageDenoise_device_cuda PRIVATE OIDN_DEVICE_CUDA_API_DRIVER)
   target_link_libraries(OpenImageDenoise_device_cuda PRIVATE curtn)
