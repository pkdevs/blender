+#ifdef NANOFLANN_PARALLEL_INVOKE
+    /**
+     * BLENDER: Same as divideTree(), but the two subtrees of a node large enough to be worth it
+     * are built through NANOFLANN_PARALLEL_INVOKE. Unlike divideTreeConcurrent() this creates no
+     * threads of its own, and the resulting tree is identical to the sequential one.
+     */
+    NodePtr divideTreeParallel(
+        Derived& obj, const Offset left, const Offset right, BoundingBox& bbox)
+    {
+        assert(static_cast<Size>(obj.vAcc_.at(left)) < obj.dataset_.kdtree_get_point_count());
+
+        NodePtr      node = this->allocateNode(obj);
+        Offset       idx;
+        Dimension    cutfeat;
+        DistanceType cutval;
+        if (makeNode(obj, node, left, right, bbox, idx, cutfeat, cutval)) return node;
+
+        BoundingBox left_bbox(bbox);
+        left_bbox[cutfeat].high = static_cast<ElementType>(cutval);
+        BoundingBox right_bbox(bbox);
+        right_bbox[cutfeat].low = static_cast<ElementType>(cutval);
+
+        if (right - left <= static_cast<Offset>(NANOFLANN_PARALLEL_GRAIN_SIZE))
+        {
+            node->child1 = this->divideTree(obj, left, left + idx, left_bbox);
+            node->child2 = this->divideTree(obj, left + idx, right, right_bbox);
+        }
+        else
+        {
+            NANOFLANN_PARALLEL_INVOKE(
+                [&]() {
+                    node->child1 = this->divideTreeParallel(obj, left, left + idx, left_bbox);
+                },
+                [&]() {
+                    node->child2 = this->divideTreeParallel(obj, left + idx, right, right_bbox);
+                });
+        }
+
+        finalizeSplitNode(obj, node, cutfeat, left_bbox, right_bbox, bbox);
+
+        return node;
+    }
+#endif /* NANOFLANN_PARALLEL_INVOKE */
