+ *  Subtrees smaller than NANOFLANN_PARALLEL_GRAIN_SIZE points are built inline, so the scheduler
+ *  isn't asked to do work that is cheaper to do directly. */
+#ifndef NANOFLANN_PARALLEL_GRAIN_SIZE
+#define NANOFLANN_PARALLEL_GRAIN_SIZE 4096
+#endif
